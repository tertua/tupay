# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="dev"

# Application branding (shown in the MPA header, footer, and page title):
APP_NAME="TuPay"

# Public registration toggle: "true" = /auth/register open (dev default),
# "false" = registration closed (403 "registration is disabled");
# login and existing sessions keep working. Advertised to the MPA via /config.
# ALLOW_REGISTRATION="true"

# Email verification on registration: "true" (default) = a new account starts
# pending (UserStatus=2), receives a 24h link, and cannot log in until it is
# verified; "false" = register auto-logs-in as before. Requires working SMTP
# (SMTP_HOST) for non-bootstrap signups. The first-install account (no users
# yet) is always active, so a fresh install with SMTP unset still bootstraps.
# REQUIRE_EMAIL_VERIFICATION="true"

# OIDC SSO login (optional, default off). One external provider via
# Authorization Code + PKCE, alongside the local password login.
#   OIDC_ENABLED=true switches the "Login with SSO" button on (advertised to
#   the MPA via /config as oidcEnabled); the other three keys are then required
#   at startup (fail fast when missing).
#   OIDC_ISSUER is the discovery base URL, e.g. https://accounts.google.com —
#   the provider must serve /.well-known/openid-configuration from it.
#   Register this redirect URI at the provider:
#     <API_PUBLIC_URL>/api/v1/auth/oidc/callback
# OIDC_ENABLED="false"
# OIDC_ISSUER=""
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid email profile"
#   Optional role sync: set OIDC_ROLE_CLAIM to the dot-path of the role list
#   inside the ID token (e.g. "realm_access.roles" for Keycloak, "roles" or
#   "groups" for Authentik). On every successful SSO login the claim is mapped
#   to the local platform role: a claim value equal to OIDC_ADMIN_ROLE grants
#   "admin", anything else (including a missing/malformed claim) demotes to
#   "user". Leave OIDC_ROLE_CLAIM empty (default) to disable mapping.
# OIDC_ROLE_CLAIM=""
# OIDC_ADMIN_ROLE="admin"


# Embedded web UI (single-container mode, see Dockerfile.dev): empty = API-only
# (default Dockerfile); set to the Vite build output to serve the frontend
# same-origin (unknown /api/* keeps the JSON 404, other misses get index.html).
# SERVE_WEBUI=""
# Legacy alias still honored when SERVE_WEBUI is empty: SERVE_SPA_DIR.
# Dockerfile.dev bakes webui/dist at /webui, so it sets SERVE_WEBUI=/webui.

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60
# Trusted reverse proxies (comma-separated IPs/CIDRs). Empty = direct
# (X-Forwarded-* ignored, cannot be spoofed). Set behind nginx/LB so
# c.IP() (rate limit, audit, captcha) sees the real client IP.
# TRUSTED_PROXIES="10.0.0.0/8, 172.16.0.5"
# PROXY_HEADER="X-Forwarded-For"

# CORS: comma-separated frontend origin(s) allowed to use cookie sessions
# cross-origin (production). Empty = permissive dev default (vite proxies
# /api same-origin, so this stays empty locally).
# CORS_ORIGINS="https://billing.example.com"

# JWT settings:
# WARNING: "secret"/"refresh" are dev-only defaults. In prod (STAGE_STATUS=prod)
# the server FAILS FAST unless both are replaced — generate with:
#   openssl rand -hex 32
JWT_SECRET_KEY="secret"
JWT_SECRET_KEY_EXPIRE_MINUTES_COUNT=15
JWT_REFRESH_KEY="refresh"
JWT_REFRESH_KEY_EXPIRE_HOURS_COUNT=720

# Database settings (following the one-api pattern):
#   - empty SQL_DSN = SQLite file, zero config (dev default, auto-created)
#   - "postgres://..." prefix = PostgreSQL (production)
#   - any other value = startup error (fail fast; MySQL is not supported)
# SQL_DSN=
SQLITE_PATH="./data/db/tupay.db"
# Production example:
#   SQL_DSN=postgres://postgres:password@template-postgres/postgres?sslmode=disable
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=2

# Redis settings (optional):
#   - empty REDIS_HOST = in-memory session store (single instance, dev default)
#   - set REDIS_HOST = shared sessions via Redis (production, multi instance)
#   - rate-limit counters follow the same rule (memory vs Redis)
# REDIS_HOST="tupay-redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB_NUMBER=0

# Hardening (P0):
# Rate limits are requests/minute (per IP, except gateway which keys by API key).
# Every value MUST be > 0: disabling a limit with 0 is not supported and a
# set-but-invalid value (0, negative, non-numeric) fails startup.
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_GATEWAY=120
# Per-request timeout for AI + gateway intent routes.
AI_TIMEOUT_SECONDS=30

# Gateway/provider tuning (defaults = previous hardcoded constants; unset keeps
# today's behaviour exactly). All values MUST be > 0.
# Provider status reconcile cadence for stale pending transactions (minutes).
GATEWAY_RECONCILE_MINUTES=15
# Per-request timeouts (seconds) for provider API calls.
GATEWAY_API_TIMEOUT_SECONDS=15
GATEWAY_PAYMENT_TIMEOUT_SECONDS=25
QR_FETCH_TIMEOUT_SECONDS=10
WEBHOOK_FORWARD_TIMEOUT_SECONDS=10
CAPTCHA_TIMEOUT_SECONDS=3
# Retry of provider 429 answers: max attempts, linear backoff base (seconds),
# and the backoff ceiling (seconds) — also caps the honored Retry-After header
# (one knob for both, since both were 30s).
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_RETRY_BASE_SECONDS=1
GATEWAY_RETRY_MAX_SECONDS=30
# Manual relay-delivery retry delay (minutes).
WEBHOOK_RETRY_MINUTES=5
# Outbox worker retry policy: dead after MAX_ATTEMPTS, backoff capped (minutes).
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_MAX_BACKOFF_MINUTES=120

# Observability (P1):
# Structured logs: text in dev, JSON in prod. Level: debug|info|warn|error.
LOG_LEVEL="info"
# Prometheus-compatible scrape endpoint at GET /metrics (hand-rolled, no deps).
METRICS_ENABLED="true"

# API governance (P2):
# Replay protection window for Idempotency-Key on payment routes (hours).
IDEMPOTENCY_TTL_HOURS=24
# Background worker: poll interval and batch size for mail outbox,
# webhook retries and idempotency purge.
OUTBOX_POLL_SECONDS=10
OUTBOX_BATCH=20
# Dashboard/report aggregate cache TTL (seconds). Redis when REDIS_HOST is
# set, process-local memory otherwise — same behaviour either way. Writes
# invalidate explicitly, so this only bounds multi-replica staleness.
CACHE_AGG_TTL_SECONDS=60
# Full-resource integration tests (skipped when unset — the default suite
# never needs services). PG DSN must point at an EMPTY scratch database;
# Redis keys are test-scoped and cleaned up (never flushed).
# INVOICEMAN_TEST_PG_DSN="postgres://user:pass@localhost:5432/invoiceman_test"
# INVOICEMAN_TEST_REDIS_ADDR="localhost:6379"

# Security hardening (P3):
# Cloudflare Turnstile (optional; empty = CAPTCHA skipped, dev default).
# TURNSTILE_SECRET is the SECRET key (server-side verification, runtime env).
# The matching SITE key is build-time for the MPA and does NOT live here:
#   - dev: webui/.env.local -> VITE_TURNSTILE_SITE_KEY
#   - embed image: docker build --build-arg VITE_TURNSTILE_SITE_KEY=...
# Both keys must come from the same Cloudflare widget. See README "Turnstile".
# TURNSTILE_SECRET=""
# Localhost-only diagnostics (pprof). Empty = disabled (default).
# DEBUG_PORT=""

# File storage for company logos (public) and expense receipts (private):
#   - "local" = files under STORAGE_DIR, served at /uploads (dev default)
#   - "s3" = any S3-compatible store (MinIO, R2, B2, AWS)
STORAGE_BACKEND="local"
STORAGE_DIR="./data/uploads"
# Public origin for stored files (S3 public-read prefix). Empty = relative
# /uploads URLs (local dev via vite proxy).
# STORAGE_PUBLIC_URL="https://cdn.example.com"
# S3 settings (required when STORAGE_BACKEND=s3):
# S3_ENDPOINT="s3.example.com"
# S3_BUCKET="invoiceman"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_USE_SSL="true"

# Gemini AI (optional):
# AI endpoints return 501 until a key is configured.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# SMTP email (optional in development):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="billing@example.com"
# APP_PUBLIC_URL="http://localhost:5173"

# Central payment relay (multi-gateway: Midtrans today, crypto-ready):
# Register this once in the Midtrans dashboard:
#   {TUPAY_PUBLIC_URL}/api/webhooks/midtrans
# Generic webhooks for current and future providers:
#   {TUPAY_PUBLIC_URL}/api/webhooks/:gateway
# MIDTRANS_SERVER_KEY=""
# MIDTRANS_CLIENT_KEY=""
# MIDTRANS_IS_PROD="false"
# NOWPayments crypto relay (optional, sandbox moves no funds):
# NOWPayments invoices are priced from amount_decimal (fiat major units,
# e.g. "25.50" USD); amount_idr-only intents are rejected with 400.
# NOWPAYMENTS_API_KEY=""
# NOWPAYMENTS_IPN_SECRET=""
# NOWPAYMENTS_SANDBOX="true"
# Optional override for tests:
# NOWPAYMENTS_BASE_URL=""
# Public origin this API is reachable at; used for provider webhooks and links.
# Fallback when TUPAY_PUBLIC_URL is empty: legacy INVOICEMAN_PUBLIC_URL.
# In prod BOTH this and APP_PUBLIC_URL must be real public URLs: the server
# fails fast if either is empty or points at localhost (breaking for
# misconfigured prod deployments — this is intentional).
# TUPAY_PUBLIC_URL="http://localhost:5000" (legacy INVOICEMAN_PUBLIC_URL still works)
# Optional override for tests (Snap endpoint):
# MIDTRANS_SNAP_BASE_URL=""
# Optional override for tests (Core API charge endpoint; QRIS on-page uses
# the Core API with acquirer=gopay, which Snap cannot express):
# MIDTRANS_CORE_BASE_URL=""
# Production checklist (local is deliberately full sandbox: with
# TUPAY_PUBLIC_URL left empty the callback falls back to localhost, so
# NOWPayments cannot reach it and settlement runs through the outbox
# reconcile poll instead of IPNs):
#   NOWPAYMENTS_API_KEY            live API key
#   NOWPAYMENTS_SANDBOX            "false" -> https://api.nowpayments.io/v1
#   TUPAY_PUBLIC_URL          https://<your-domain> ; NOWPayments IPN is
#                                  sent per invoice to
#                                  {base}/api/webhooks/nowpayments, so no
#                                  callback URL is registered on their side
#   MIDTRANS_SERVER_KEY/CLIENT_KEY live keys, MIDTRANS_IS_PROD "true"
#   Midtrans dashboard             register {TUPAY_PUBLIC_URL}/api/webhooks/midtrans
#   NOWPAYMENTS_BASE_URL           keep empty (test override only)
# Webhooks settle instantly; the reconcile poll (15 min) heals missed ones.
# Future providers follow the same pattern (e.g. COINPAYMENTS_*):
# each gateway is one package implementing platform/gateway.Gateway.
#
# Provider blocks: any env key of the form <PROVIDER>_<KEY> is picked up
# automatically — the provider package reads it via configs.Provider("<provider>")
# (e.g. MIDTRANS_SERVER_KEY -> Provider("midtrans")["server_key"]). Adding a
# provider needs no pkg/configs change: register its package and set
# XENDIT_API_KEY / XENDIT_CALLBACK_TOKEN / ... , upper-snake of the registry
# name. Existing keys (MIDTRANS_*, NOWPAYMENTS_*) keep their exact names.
