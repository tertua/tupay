# Dev/all-in-one image: API + embedded Vite MPA in a single container.
# Production default stays split (Dockerfile = API-only, FE hosted
# separately); use this when one container is simpler (VPS, demo).
#
# Build (BuildKit; Dockerfile.dev.dockerignore keeps webui/ sources in context):
#   docker build -f Dockerfile.dev -t tupay:dev .
# With captcha (see README "Turnstile"):
#   docker build -f Dockerfile.dev \
#     --build-arg VITE_TURNSTILE_SITE_KEY=<site-key> -t tupay:dev .
# Run:   docker run --rm -p 5000:5000 --env-file .env tupay:dev
# Then open http://localhost:5000 (MPA) — /api/* is served same-origin,
# so no CORS or vite proxy is needed.

# dist is plain JS/CSS — arch-independent — so build it natively on the
# build platform; only the Go binary needs cross-compiling for other arches.
FROM --platform=$BUILDPLATFORM oven/bun:1.4-alpine AS frontend
WORKDIR /fe
COPY webui/package.json webui/bun.lock ./
RUN bun install --frozen-lockfile
COPY webui/ ./
# Turnstile SITE key is build-time: Vite inlines VITE_* into the bundle, so
# an embedded MPA must receive it here, not at runtime. Pass it with
# --build-arg when the API enforces captcha; empty = widget hidden.
# The matching SECRET key is runtime-only (docker --env-file) — never here.
ARG VITE_TURNSTILE_SITE_KEY=""
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
RUN bun run build

FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS builder
LABEL maintainer="Candro Aleandro <admin@tanet.eu.org> (https://tanet.eu.org)"
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# dist is built in the frontend stage and copied straight into the runtime
# image; the Go build never needs it (no go:embed).
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w" -o tupay .
# Writable state dir for the non-root runtime user; scratch has no shell to
# create it later (defaults: SQLITE_PATH=./data/db/*, STORAGE_DIR=./data/uploads).
RUN mkdir -p /out/data

FROM scratch
COPY --from=builder ["/build/tupay", "/"]
COPY --from=frontend ["/fe/dist", "/webui"]
COPY --from=builder ["/build/VERSION", "/VERSION"]
COPY --from=builder --chown=65532:65532 ["/out/data", "/data"]

# Serve the MPA from /webui (same word as SERVE_WEBUI, webui/, MountWebUI).
ENV SERVE_WEBUI=/webui

# Non-root: scratch has no /etc/passwd, numeric UID/GID 65532 (distroless
# "nonroot" convention; nobody would be 65534). Bind-mounted state must be
# owned by it on the host: chown -R 65532:65532 data/
USER 65532:65532

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD ["/tupay", "-healthcheck"]

ENTRYPOINT ["/tupay"]
